# ----------------------------------------------------------------------
# Load 1000 512-dimension image embeddings generated with a multi-modal
# model and search them using text embeddings generated with the same
# model. This will result in low accuracy due to the modality gap.
# ----------------------------------------------------------------------

new-index dataset=clip-512d-1050.gob train-count=1000 distance-metric=InnerProduct min-partition-size=4 max-partition-size=16 quality-samples=8 beam-size=4
----
Created index with 1000 vectors with 512 dimensions.
3 levels, 199 partitions.
CV stats:
  level 2 - mean: 0.0000, stdev: 0.0000
  level 3 - mean: 0.0000, stdev: 0.0000

recall topk=10 beam-size=4 samples=50
----
20.60% recall@10
45 leaf vectors, 76 vectors, 30 full vectors, 7 partitions

recall topk=10 beam-size=8 samples=50
----
40.00% recall@10
89 leaf vectors, 142 vectors, 39 full vectors, 13 partitions

recall topk=10 beam-size=16 samples=50
----
67.20% recall@10
175 leaf vectors, 276 vectors, 50 full vectors, 25 partitions

recall topk=10 beam-size=32 samples=50
----
84.80% recall@10
348 leaf vectors, 449 vectors, 59 full vectors, 41 partitions

recall topk=10 beam-size=64 samples=50
----
96.80% recall@10
693 leaf vectors, 794 vectors, 70 full vectors, 73 partitions

# Accuracy tops out here because of quantization error due to an incomplete
# RaBitQ error bounds implementation.
recall topk=10 beam-size=128 samples=50
----
100.00% recall@10
1000 leaf vectors, 1101 vectors, 72 full vectors, 102 partitions

# Do not fetch extra results for reranking. Expect recall to drop significantly.
recall topk=10 beam-size=32 samples=50 rerank-multiplier=0
----
80.00% recall@10
348 leaf vectors, 449 vectors, 12 full vectors, 41 partitions

# ----------------------------------------------------------------------
# Search 950 100-dimension word embeddings generated by the GloVe model.
